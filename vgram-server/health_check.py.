
from fastapi import FastAPI
from datetime import datetime, timezone

app = FastAPI(
    title="VGRAM Server",
    version="0.2.1"
)

@app.get("/")
def home():
    return {
        "ok": True,
        "service": "vgram-server",
        "message": "VGRAM server is running"
    }

@app.get("/health")
def health():
    return {
        "ok": True,
        "service": "vgram-server",
        "version": app.version,
        "time": datetime.now(timezone.utc).isoformat()
    }
